      ]
    },
    {
      "obligation_id": "obligation:ym-local-lemma-density-20260930",
      "kind": "lemma",
      "statement": {
        "text": "Under the root assumptions and the spectral leaf conclusion, boundedness of E_H([0,a]) extends its vanishing from D to Omega-perp. Taking rational a increasing to m and using countable continuity of spectral projections gives E_H([0,m)) zero on Omega-perp; the endpoint m is allowed.",
        "language": "en",
        "formal_declaration": null
      },
